#!/usr/bin/env bash
# summon/test - negative + positive coverage for `summon lint`.
#
# CI only runs `summon lint` against the repo's own (valid) tree, so a
# regression that weakens a rule would keep CI green. This harness builds
# throwaway fixture repos under a temp dir, points a copy of `summon/main` at
# each, and asserts the linter's exit code (and, for failures, the message).
# Run: ./summon/test  (or: bash summon/test).
set -uo pipefail

SELF_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN="$SELF_DIR/main"

pass=0 fail=0
ok()   { printf '  ok   - %s\n' "$1"; pass=$((pass+1)); }
bad()  { printf '  FAIL - %s\n' "$1"; fail=$((fail+1)); }

# Build a minimal, fully-valid fixture repo in $1: a utility, a top-level
# skill, and a Claude Code plugin (manifest + marketplace listing + its own
# namespaced skill). All pass lint. Individual tests then mutate a copy to trip
# one rule.
seed_repo() {
  local root="$1"
  mkdir -p "$root/summon" "$root/utilities/good-tool" \
           "$root/skills/stacia-good-skill" \
           "$root/plugins/.claude-plugin" \
           "$root/plugins/good-plugin/.claude-plugin" \
           "$root/plugins/good-plugin/skills/good-plugin-skill"
  cp "$MAIN" "$root/summon/main"; chmod +x "$root/summon/main"

  cat > "$root/utilities/good-tool/main" <<'EOF'
#!/usr/bin/env bash
[[ "${1:-}" == "--help" ]] && { echo "good-tool - a valid fixture tool"; exit 0; }
echo run
EOF
  chmod +x "$root/utilities/good-tool/main"

  cat > "$root/skills/stacia-good-skill/SKILL.md" <<'EOF'
---
name: stacia-good-skill
description: A valid fixture skill.
---
body
EOF

  # The marketplace name is hardcoded in the linter (CC_MARKETPLACE), so the
  # fixture has to use it too.
  cat > "$root/plugins/.claude-plugin/marketplace.json" <<'EOF'
{
  "name": "stacia-utils",
  "owner": { "name": "Fixture" },
  "plugins": [
    { "name": "good-plugin", "source": "./good-plugin", "description": "A valid fixture plugin." }
  ]
}
EOF

  cat > "$root/plugins/good-plugin/.claude-plugin/plugin.json" <<'EOF'
{
  "name": "good-plugin",
  "description": "A valid fixture plugin.",
  "version": "0.0.1"
}
EOF

  cat > "$root/plugins/good-plugin/skills/good-plugin-skill/SKILL.md" <<'EOF'
---
name: good-plugin-skill
description: A valid fixture plugin skill.
---
body
EOF
}

# run_lint <root> -> sets RC and LINT_OUT
run_lint() { LINT_OUT="$("$1/summon/main" lint 2>&1)"; RC=$?; }

# expect_pass <label> <root>
expect_pass() {
  run_lint "$2"
  if [[ $RC -eq 0 ]]; then ok "$1"; else
    bad "$1 (expected exit 0, got $RC)"; printf '%s\n' "$LINT_OUT" | sed 's/^/      /'
  fi
}

# expect_fail <label> <root> <substring-of-expected-message>
expect_fail() {
  run_lint "$2"
  if [[ $RC -eq 0 ]]; then
    bad "$1 (expected non-zero exit, got 0)"
  elif [[ "$LINT_OUT" != *"$3"* ]]; then
    bad "$1 (exit $RC but message missing: '$3')"; printf '%s\n' "$LINT_OUT" | sed 's/^/      /'
  else
    ok "$1"
  fi
}

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
# Mint a fresh, isolated fixture repo each call. mktemp -d (not a shared counter)
# because new_repo runs in a command-substitution subshell, where a parent-scope
# counter increment would not persist and every repo would collide.
new_repo() { local r; r="$(mktemp -d "$TMP/repo.XXXXXX")"; seed_repo "$r"; printf '%s' "$r"; }

echo "summon lint fixtures:"

# Baseline: the seeded repo is valid.
r="$(new_repo)"; expect_pass "valid repo passes" "$r"

# --- utility rule (spot check the linter still fires at all) ---
r="$(new_repo)"
sed -i.bak 's/good-tool - a valid fixture tool/no leading synopsis/' "$r/utilities/good-tool/main"
expect_fail "utility bad --help synopsis" "$r" "line 1 of --help must be"

# --- skill rules (spot checks) ---
r="$(new_repo)"
sed -i.bak '/^description: A valid fixture skill\.$/d' "$r/skills/stacia-good-skill/SKILL.md"
expect_fail "skill missing description" "$r" "'description:' must be non-empty"

r="$(new_repo)"
mv "$r/skills/stacia-good-skill" "$r/skills/good-skill"
sed -i.bak 's/^name: stacia-good-skill$/name: good-skill/' "$r/skills/good-skill/SKILL.md"
expect_fail "skill missing stacia- prefix" "$r" "must be prefixed with 'stacia-'"

# --- Claude Code plugin rules ---
# A plugin's entrypoint is its manifest — .claude-plugin/plugin.json, the file
# Claude Code actually reads. Without it the directory is not a plugin, and
# without a marketplace listing `summon setup` installs nothing.
r="$(new_repo)"
rm -f "$r/plugins/good-plugin/.claude-plugin/plugin.json"
expect_fail "plugin missing plugin.json entrypoint" "$r" \
  "missing entrypoint (expected plugins/good-plugin/.claude-plugin/plugin.json)"

r="$(new_repo)"
sed -i.bak 's/"name": "good-plugin"/"name": "wrong-name"/' "$r/plugins/good-plugin/.claude-plugin/plugin.json"
expect_fail "plugin.json name mismatches its dir" "$r" \
  "plugin.json 'name' must equal 'good-plugin'"

r="$(new_repo)"
rm -f "$r/plugins/.claude-plugin/marketplace.json"
expect_fail "missing marketplace manifest" "$r" "missing marketplace manifest"

r="$(new_repo)"
sed -i.bak 's/^  "name": "stacia-utils",$/  "name": "some-other-marketplace",/' \
  "$r/plugins/.claude-plugin/marketplace.json"
expect_fail "marketplace manifest misnamed" "$r" \
  "marketplace manifest must declare \"name\": \"stacia-utils\""

r="$(new_repo)"
sed -i.bak 's/{ "name": "good-plugin", "source"/{ "name": "other-plugin", "source"/' \
  "$r/plugins/.claude-plugin/marketplace.json"
expect_fail "plugin absent from the marketplace" "$r" \
  "not listed in the stacia-utils marketplace manifest"

r="$(new_repo)"
mv "$r/plugins/good-plugin/skills/good-plugin-skill" "$r/plugins/good-plugin/skills/renamed-skill"
expect_fail "plugin skill frontmatter name mismatches its dir" "$r" \
  "skill renamed-skill: frontmatter 'name:' must equal 'renamed-skill'"

r="$(new_repo)"
sed -i.bak '/^description: A valid fixture plugin skill\.$/d' \
  "$r/plugins/good-plugin/skills/good-plugin-skill/SKILL.md"
expect_fail "plugin skill missing description" "$r" \
  "skill good-plugin-skill: frontmatter 'description:' must be non-empty"

r="$(new_repo)"
rm -f "$r/plugins/good-plugin/skills/good-plugin-skill/SKILL.md"
expect_fail "plugin skill missing SKILL.md" "$r" \
  "skill good-plugin-skill: missing entrypoint"

# A plugin's skills are namespaced by the plugin (/<plugin>:<skill>), so unlike
# top-level skills/ they are deliberately NOT required to be stacia-prefixed.
r="$(new_repo)"
expect_pass "plugin skill needs no stacia- prefix" "$r"

echo
printf 'summon/test: %d passed, %d failed\n' "$pass" "$fail"
[[ $fail -eq 0 ]]
