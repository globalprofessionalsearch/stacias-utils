#!/usr/bin/env bash
# summon - discover and run Stacia's personal utilities and Claude Code plugins
#
# The repo holds two kinds of thing, each in its own top-level directory:
#
#   utilities/<name>/main       an executable whose `--help` prints, on line 1,
#                               a man-page-style synopsis: "<name> - <desc>"
#   plugins/<name>/             a Claude Code plugin; its entrypoint is the
#     .claude-plugin/plugin.json manifest, and its own skills live in
#                               plugins/<name>/skills/<skill>/SKILL.md.
#
# Both are self-describing: `summon list` harvests utility synopses from
# `main --help` and plugin-skill synopses from frontmatter, so there is nothing
# to regenerate. `summon lint` enforces both contracts.
#
# `summon setup` installs Claude Code plugins via the local marketplace in
# plugins/ (see install_plugins — a symlink does NOT work).
# The marketplace manifest is authored and committed, never generated here;
# `summon lint` only reports where it has stopped matching what is on disk.
# Everything else at the repo root is infrastructure.
#
# Sugar: a leading run of filler words (a an the this that these those up me my
# some) is ignored, so `summon ctx`, `summon the ctx`, and `summon up a ctx` are
# all equivalent. Summon the tools.
set -euo pipefail

# ---------------------------------------------------------------------------
# Locate the repo root by resolving this script through any symlinks (the one
# PATH entry, bin/summon, is a symlink to <repo>/summon/main).
# ---------------------------------------------------------------------------
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _dir="$(cd -P "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  case "$_self" in /*) : ;; *) _self="$_dir/$_self" ;; esac
done
SELF_DIR="$(cd -P "$(dirname "$_self")" && pwd)"   # <repo>/summon
REPO="$(dirname "$SELF_DIR")"
UTIL_DIR="$REPO/utilities"   # executable utilities:    <name>/main
PLUGIN_DIR="$REPO/plugins"   # Claude Code plugins:     <name>/.claude-plugin/plugin.json

# Leading filler/incantation words stripped before dispatch (see main()).
FILLER="a an the this that these those up me my some"
# Names that can never be a utility: builtins, filler words, dispatcher.
RESERVED="list lint commit-lint setup help summon $FILLER"

err()  { printf '%s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

# Print the names of all utilities (dirs under utilities/ with a `main`), sorted.
utils() {
  local d name
  for d in "$UTIL_DIR"/*/; do
    [[ -d "$d" ]] || continue
    name="$(basename "$d")"
    [[ -f "$d/main" ]] || continue
    printf '%s\n' "$name"
  done | LC_ALL=C sort
}

# Print the names of all Claude Code plugins, sorted. Every (non-dot) dir under
# plugins/ is one; whether it *conforms* is the linter's business.
plugins() {
  local d
  for d in "$PLUGIN_DIR"/*/; do
    [[ -d "$d" ]] || continue
    printf '%s\n' "$(basename "$d")"
  done | LC_ALL=C sort
}

# Line 1 of a utility's `--help` (its synopsis). Empty if it produced none.
synopsis() {
  local name="$1"
  "$UTIL_DIR/$name/main" --help 2>/dev/null </dev/null | head -n1
}

# A YAML frontmatter field value (name/description) from any file. Empty if absent.
frontmatter_field() {
  local file="$1" key="$2"
  awk -v k="$key" '
    NR==1 && $0!~/^---[[:space:]]*$/ { exit }
    NR>1 && /^---[[:space:]]*$/ { exit }
    NR>1 {
      if (match($0, "^" k ":[[:space:]]*")) {
        print substr($0, RLENGTH+1); exit
      }
    }
  ' "$file"
}

# Claude Code plugin install. Discovery is marketplace-mediated: there is no
# ~/.claude/plugins/<name> auto-scan, and symlinks planted there are ignored
# (installing COPIES the plugin into ~/.claude/plugins/cache/). So `plugins/` is
# itself the marketplace — plugins/.claude-plugin/marketplace.json — and
# `summon setup` registers it once, then installs each plugin at user scope.
#   https://code.claude.com/docs/en/plugins
#   https://code.claude.com/docs/en/plugin-marketplaces
CC_MARKETPLACE="stacia-utils"
CC_MARKETPLACE_MANIFEST="$PLUGIN_DIR/.claude-plugin/marketplace.json"

# ---------------------------------------------------------------------------
# Builtins
# ---------------------------------------------------------------------------
cmd_help() {
  cat <<EOF
summon - discover and run Stacia's personal utilities and Claude Code plugins

Usage:
  summon list                    List every utility and plugin with its synopsis
  summon [filler] <name> [args]  Run a utility (leading a/an/the/this/that/
                                 these/those/up/me/my/some are optional sugar)
  summon [filler] <name> --help  Show a utility's full help
  summon lint                    Enforce the utility + plugin contracts
                                 (CI + hook)
  summon commit-lint <file|->    Validate a Conventional Commits message
  summon setup                   Configure hooks, install plugins, print
                                 shell-rc hints
  summon help | --help           Show this help

Utilities: utilities/<name>/main (\`--help\` line 1 is "<name> - <desc>").
Plugins:   plugins/<name>/.claude-plugin/plugin.json (Claude Code; invoked
           there as /<name>:<skill>, never through \`summon\`).
Run \`summon list\`.
EOF
}

cmd_list() {
  local name syn missing=0 desc

  echo "Utilities:"
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    syn="$(synopsis "$name" || true)"
    if [[ -z "$syn" ]]; then
      printf '  %-18s (no --help synopsis; run: summon lint)\n' "$name"
      missing=1
    else
      printf '  %s\n' "$syn"
    fi
  done < <(utils)

  # Claude Code plugins aren't run through `summon`; they're installed by
  # `summon setup` and invoked in Claude Code as /<plugin>:<skill>. Listed so
  # `summon list` stays the one place that answers "what is in this repo".
  local n=0 sd sname
  while IFS= read -r name; do [[ -n "$name" ]] && n=$((n+1)); done < <(plugins)
  if [[ $n -gt 0 ]]; then
    echo
    echo "Claude Code plugins (installed by \`summon setup\`):"
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      printf '  %s\n' "$name"
      for sd in "$PLUGIN_DIR/$name/skills"/*/; do
        [[ -f "$sd/SKILL.md" ]] || continue
        sname="$(basename "$sd")"
        desc="$(frontmatter_field "$sd/SKILL.md" description || true)"
        if [[ -z "$desc" ]]; then
          printf '    /%s:%-18s (no description; run: summon lint)\n' "$name" "$sname"
          missing=1
        else
          printf '    /%s:%s - %s\n' "$name" "$sname" "$desc"
        fi
      done
    done < <(plugins)
  fi

  return $missing
}

# ---------------------------------------------------------------------------
# Linter: hard-ass enforcement of the utility contract.
# ---------------------------------------------------------------------------
cmd_lint() {
  local fail=0 name kebab='^[a-z0-9]+(-[a-z0-9]+)*$'

  # No stray executables loose at the repo root: all code lives in its own dir.
  local f
  for f in "$REPO"/*; do
    [[ -f "$f" && -x "$f" ]] || continue
    err "LINT: stray executable at repo root: $(basename "$f") (move it into utilities/<name>/main)"
    fail=1
  done

  # Every directory under utilities/ must be a conforming utility.
  local d
  for d in "$UTIL_DIR"/*/; do
    [[ -d "$d" ]] || continue
    name="$(basename "$d")"

    if [[ ! "$name" =~ $kebab ]]; then
      err "LINT: $name: name must be kebab-case ([a-z0-9] and single hyphens)"; fail=1
    fi
    case " $RESERVED " in *" $name "*)
      err "LINT: $name: reserved name (clashes with a summon builtin)"; fail=1 ;;
    esac

    if [[ ! -e "$d/main" ]]; then
      err "LINT: $name: no entrypoint (expected $name/main)"; fail=1; continue
    fi
    if [[ ! -f "$d/main" || ! -x "$d/main" ]]; then
      err "LINT: $name: main must be an executable file (chmod +x $name/main)"; fail=1; continue
    fi
    if ! head -c2 "$d/main" | grep -q '^#!'; then
      err "LINT: $name: main must start with a shebang (#!...)"; fail=1
    fi

    # The contract: `main --help` exits 0 and prints "<name> - <desc>" on line 1.
    local out rc line1
    out="$("$d/main" --help 2>/dev/null </dev/null)" && rc=0 || rc=$?
    if [[ $rc -ne 0 ]]; then
      err "LINT: $name: 'main --help' must exit 0 (got $rc)"; fail=1
    fi
    line1="$(printf '%s\n' "$out" | head -n1)"
    if [[ -z "$line1" ]]; then
      err "LINT: $name: 'main --help' printed nothing to stdout"; fail=1
    elif [[ "$line1" != "$name - "* || "$line1" == "$name - " ]]; then
      err "LINT: $name: line 1 of --help must be '$name - <description>' (got: ${line1:-<empty>})"
      fail=1
    fi
  done

  # Every directory under plugins/ must be a conforming Claude Code plugin.
  # A plugin's entrypoint is its manifest, .claude-plugin/plugin.json — that is
  # the file Claude Code reads; without it the directory is not a plugin at all.
  # Plugins are published through the local marketplace at
  # plugins/.claude-plugin/marketplace.json. That file is AUTHORED, like any
  # other source file: it is a product of development, not a build artifact.
  # Nothing generates or rewrites it — the linter's job is to tell you when it
  # has stopped being accurate, and say precisely what is wrong so you can fix
  # it by hand.
  if [[ -d "$PLUGIN_DIR" ]]; then
    if [[ ! -f "$CC_MARKETPLACE_MANIFEST" ]]; then
      err "LINT: plugins: missing marketplace manifest ($CC_MARKETPLACE_MANIFEST)"; fail=1
    else
      while IFS= read -r problem; do
        [[ -n "$problem" ]] || continue
        err "LINT: marketplace: $problem"; fail=1
      done < <(check_marketplace)
    fi

    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      d="$PLUGIN_DIR/$name"

      if [[ ! "$name" =~ $kebab ]]; then
        err "LINT: plugin $name: name must be kebab-case ([a-z0-9] and single hyphens)"; fail=1
      fi

      local manifest="$d/.claude-plugin/plugin.json"
      if [[ ! -f "$manifest" ]]; then
        err "LINT: plugin $name: missing entrypoint (expected plugins/$name/.claude-plugin/plugin.json)"; fail=1; continue
      fi
      if ! grep -q "\"name\"[[:space:]]*:[[:space:]]*\"$name\"" "$manifest"; then
        err "LINT: plugin $name: plugin.json 'name' must equal '$name'"; fail=1
      fi
      # A plugin's skills are namespaced by the plugin (/<plugin>:<skill>), so
      # the stacia- prefix isn't needed here — but the frontmatter contract is
      # the same frontmatter contract.
      local sd sname
      for sd in "$d/skills"/*/; do
        [[ -d "$sd" ]] || continue
        sname="$(basename "$sd")"
        if [[ ! "$sname" =~ $kebab ]]; then
          err "LINT: plugin $name: skill $sname: name must be kebab-case"; fail=1
        fi
        if [[ ! -f "$sd/SKILL.md" ]]; then
          err "LINT: plugin $name: skill $sname: missing entrypoint (expected skills/$sname/SKILL.md)"; fail=1; continue
        fi
        if [[ "$(head -n1 "$sd/SKILL.md")" != "---" ]]; then
          err "LINT: plugin $name: skill $sname: SKILL.md must open with a YAML frontmatter block (---)"; fail=1
        fi
        local pfname pfdesc
        pfname="$(frontmatter_field "$sd/SKILL.md" name || true)"
        pfdesc="$(frontmatter_field "$sd/SKILL.md" description || true)"
        if [[ "$pfname" != "$sname" ]]; then
          err "LINT: plugin $name: skill $sname: frontmatter 'name:' must equal '$sname' (got: ${pfname:-<empty>})"; fail=1
        fi
        if [[ -z "$pfdesc" ]]; then
          err "LINT: plugin $name: skill $sname: frontmatter 'description:' must be non-empty"; fail=1
        fi
      done
    done < <(plugins)
  fi

  # The dispatcher must obey its own contract too.
  local s
  s="$("$SELF_DIR/main" --help 2>/dev/null </dev/null | head -n1)"
  [[ "$s" == "summon - "* ]] || { err "LINT: summon: own --help line 1 malformed"; fail=1; }

  if [[ $fail -eq 0 ]]; then
    echo "lint OK ($(utils | grep -c . || true) utilities, $(plugins | grep -c . || true) plugins)"
  fi
  return $fail
}

# ---------------------------------------------------------------------------
# Conventional Commits validator (shared by commit-msg hook and CI).
# ---------------------------------------------------------------------------
cmd_commit_lint() {
  local src="${1:--}" message subject
  local pattern='^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\(.+\))?(!)?: .+'
  if [[ "$src" == "-" ]]; then message="$(cat)"; else message="$(cat "$src")"; fi
  subject="$(printf '%s\n' "$message" | head -n1)"
  if printf '%s' "$subject" | grep -qE "$pattern"; then exit 0; fi
  cat >&2 <<EOF
Commit subject must follow Conventional Commits:

  type(scope?): subject

types: feat fix docs style refactor perf test chore ci build revert

Your subject:
  $subject
EOF
  exit 1
}

# ---------------------------------------------------------------------------
# Claude Code plugin install.
#
# NOT the pi trick. pi recurses into one umbrella symlink, so linking skills/
# once exposes every current and future skill for free. Claude Code has no
# analogue: it does not scan ~/.claude/plugins/ for plugin directories, and
# symlinks planted there are ignored. Discovery is marketplace-mediated, and
# `plugin install` COPIES the plugin into
# ~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/.
#   https://code.claude.com/docs/en/plugins
#   https://code.claude.com/docs/en/plugin-marketplaces
#
# So plugins/ is itself the marketplace (plugins/.claude-plugin/marketplace.json),
# registered once by path; every plugin listed there is installed at user scope
# so it is available in any project.
#
# `setup` runs once because there is ONE umbrella plugin, `stacia`. A utility is
# a directory under plugins/stacia/skills/<utility>/, self-contained (SKILL.md
# plus whatever bin/ and code it needs). Adding or removing one is a mkdir or an
# rm — it never adds a plugin, so it never needs a new install. Only creating a
# genuinely new *plugin* would.
#
# Caveat worth knowing: `plugin install` records an installPath under
# ~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/ and pins a version +
# commit sha. For a `directory`-source marketplace, CLAUDE_PLUGIN_ROOT resolves
# to this repo at runtime, so edits are live; the cache copy is a shadow that
# can lag. If you ever see stale behaviour, that shadow is the first suspect.
# ---------------------------------------------------------------------------
# Check the AUTHORED marketplace manifest against what is actually on disk.
# The manifest is a product of development, not a build artifact: nothing here
# generates or rewrites it. This only reports what has stopped being true, one
# problem per line on stdout, so the message names the fix rather than telling
# you to regenerate.
#
# Deliberately NOT checked: the marketplace `description`, `owner`, and each
# entry's `description`. Those are editorial — the manifest is what a reader
# sees when browsing the marketplace, and forcing them to equal plugin.json
# would make the two files one file with extra steps. Presence is required;
# wording is yours.
check_marketplace() {
  python3 - "$PLUGIN_DIR" "$CC_MARKETPLACE" "$CC_MARKETPLACE_MANIFEST" <<'MKTCHECK'
import json, sys, pathlib

plugin_dir, market, manifest_path = pathlib.Path(sys.argv[1]), sys.argv[2], pathlib.Path(sys.argv[3])
problems = []

try:
    man = json.loads(manifest_path.read_text())
except Exception as exc:
    print(f"manifest is not valid JSON: {exc}")
    raise SystemExit(0)

if man.get("name") != market:
    problems.append(f'manifest "name" must be "{market}" (got {man.get("name")!r})')
if not (man.get("owner") or {}).get("name"):
    problems.append('manifest needs an "owner" with a non-empty "name"')
if not str(man.get("description", "")).strip():
    problems.append('manifest needs a non-empty "description"')

entries = man.get("plugins")
if not isinstance(entries, list):
    problems.append('manifest needs a "plugins" array')
    for p in problems:
        print(p)
    raise SystemExit(0)

listed = {}
for i, e in enumerate(entries):
    name = e.get("name")
    if not name:
        problems.append(f'plugins[{i}] needs a "name"')
        continue
    if name in listed:
        problems.append(f"{name}: listed twice")
    listed[name] = e

# Every plugin on disk must be published, or `summon setup` silently skips it.
on_disk = {}
for d in sorted(q for q in plugin_dir.iterdir() if q.is_dir() and not q.name.startswith(".")):
    pj = d / ".claude-plugin" / "plugin.json"
    if not pj.is_file():
        continue  # not a plugin; the plugin rules complain about it separately
    try:
        on_disk[json.loads(pj.read_text()).get("name", d.name)] = d.name
    except Exception:
        continue  # unreadable plugin.json; the plugin rules cover it

for name, dirname in sorted(on_disk.items()):
    e = listed.get(name)
    if e is None:
        problems.append(f"{name}: on disk but not listed - add it, or `summon setup` will never install it")
        continue
    if e.get("source") != f"./{dirname}":
        problems.append(f'{name}: "source" must be "./{dirname}" (got {e.get("source")!r})')
    if not str(e.get("description", "")).strip():
        problems.append(f'{name}: needs a non-empty "description"')

for name in sorted(listed):
    if name not in on_disk:
        problems.append(f"{name}: listed but no such plugin on disk - remove it, or add plugins/{name}/")

for p in problems:
    print(p)
MKTCHECK
}

install_plugins() {
  local name
  [[ "$(plugins | grep -c . || true)" -gt 0 ]] || return 0

  # The manifest is authored and committed, not generated here. `summon setup`
  # installs what it says; keeping it accurate is `summon lint`'s job to report
  # and yours to fix.
  if [[ ! -f "$CC_MARKETPLACE_MANIFEST" ]]; then
    err "! claude: no marketplace manifest at $CC_MARKETPLACE_MANIFEST — skipping plugin install"
    err "    Create it and list each plugin under \"plugins\"; \`summon lint\` will check it."
    return 0
  fi
  if ! command -v claude >/dev/null 2>&1; then
    err "! claude: CLI not on PATH — skipping plugin install. Once it is, run:"
    err "    claude plugin marketplace add \"$PLUGIN_DIR\""
    err "    claude plugin install <name>@$CC_MARKETPLACE --scope user"
    return 0
  fi

  # `add` on a first run, `update` on every run after. Either is enough.
  if claude plugin marketplace add "$PLUGIN_DIR" >/dev/null 2>&1 \
     || claude plugin marketplace update "$CC_MARKETPLACE" >/dev/null 2>&1; then
    echo "✓ claude: marketplace '$CC_MARKETPLACE' registered (-> plugins/)"
  else
    err "! claude: could not register the marketplace at $PLUGIN_DIR — skipping plugin install"
    return 0
  fi

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    if claude plugin install "$name@$CC_MARKETPLACE" --scope user >/dev/null 2>&1; then
      echo "✓ claude: plugin installed ($name@$CC_MARKETPLACE, user scope) — invoke /$name:<skill>"
    elif claude plugin update "$name@$CC_MARKETPLACE" >/dev/null 2>&1; then
      echo "✓ claude: plugin updated ($name@$CC_MARKETPLACE) — invoke /$name:<skill>"
    else
      err "! claude: could not install $name@$CC_MARKETPLACE"
      err "    try: claude plugin install $name@$CC_MARKETPLACE --scope user"
    fi
  done < <(plugins)

  echo "  (adding a utility under plugins/stacia/skills/ needs no re-run: it is the"
  echo "   same plugin. Only a brand-new plugin directory would.)"
}

# ---------------------------------------------------------------------------
# One-shot setup: git hooks + Claude Code plugins + shell-rc hints.
# Idempotent.
#  - Claude Code plugins: registered via the local marketplace in plugins/ and
#    installed at user scope. NOT a symlink — see install_plugins.
# ---------------------------------------------------------------------------
cmd_setup() {
  git -C "$REPO" config core.hooksPath .githooks
  echo "✓ git hooks enabled (core.hooksPath=.githooks)"

  install_plugins

  # NOTE: a previous revision pruned repo-owned symlinks out of ~/.claude/skills
  # here, on the premise that Claude Code was permanently unwired. That premise
  # is being reversed — the code-review coordinator is moving to Claude Code —
  # so the pruner is removed. Do not reinstate it: it would uninstall the port
  # on the next `summon setup`.

  cat <<EOF

Add this line to your shell rc (once):

  export PATH="$REPO/bin:\$PATH"

That puts \`summon\` on PATH.

Then: summon list
EOF
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
main() {
  # Sugar: strip a leading run of filler words so `summon up the ctx` == `summon
  # ctx`. Remember what we stripped so an all-filler call can echo it back.
  local stripped=""
  while [[ $# -gt 0 ]]; do
    case " $FILLER " in
      *" $1 "*) stripped="${stripped:+$stripped }$1"; shift ;;
      *)        break ;;
    esac
  done
  if [[ -n "$stripped" && $# -eq 0 ]]; then
    err "summon $stripped what?"
    cmd_help
    exit 0
  fi
  local cmd="${1:-help}"
  case "$cmd" in
    help|-h|--help) cmd_help ;;
    list)           shift; cmd_list "$@" ;;
    lint)           shift; cmd_lint "$@" ;;
    commit-lint)    shift; cmd_commit_lint "$@" ;;
    setup)          shift; cmd_setup "$@" ;;
    *)
      if [[ -x "$UTIL_DIR/$cmd/main" ]]; then
        shift; exec "$UTIL_DIR/$cmd/main" "$@"
      fi
      err "summon: unknown utility or command: $cmd"
      err "Run 'summon list' to see what's available."
      exit 127
      ;;
  esac
}

main "$@"
