#!/usr/bin/env bash
# Enforce the utility/skill/plugin contracts before every commit, and run the
# code-review test suite when its tree is touched (same gating as lint).
set -e
root="$(git rev-parse --show-toplevel)"
"$root/summon/main" lint

staged="$(git diff --cached --name-only)"

if printf '%s\n' "$staged" | grep -q '^plugins/stacia-code-review/'; then
  "$root/plugins/stacia-code-review/test.sh"
fi
