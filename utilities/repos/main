#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="$HOME/Documents/code/github/globalprofessionalsearch"

repo_name=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      cat <<EOF
repos - resolve a Jeenie repository path under globalprofessionalsearch

Usage: repos [REPO]

  REPO  Optional repository directory name under globalprofessionalsearch.
        If omitted, prints the base repos directory.

Examples:
  repos                      Print $BASE_DIR
  repos dagster-pipeline     Print path to dagster-pipeline repo
  cd \$(summon repos my-svc)  Jump to a repo by name
EOF
      exit 0
      ;;
    -*)
      echo "repos: unknown flag: $1" >&2
      echo "Run 'repos --help' for usage." >&2
      exit 1
      ;;
    *)
      if [[ -n "$repo_name" ]]; then
        echo "repos: unexpected argument: $1" >&2
        echo "Run 'repos --help' for usage." >&2
        exit 1
      fi
      repo_name="$1"
      shift
      ;;
  esac
done

if [[ -n "$repo_name" ]]; then
  TARGET_DIR="$BASE_DIR/$repo_name"
else
  TARGET_DIR="$BASE_DIR"
fi

if [[ ! -d "$TARGET_DIR" ]]; then
  if [[ -n "$repo_name" ]]; then
    echo "repos: repository not found: $repo_name" >&2
    echo "Expected at: $TARGET_DIR" >&2
  else
    echo "repos: directory not found: $TARGET_DIR" >&2
  fi
  exit 1
fi

printf '%s\n' "$TARGET_DIR"
